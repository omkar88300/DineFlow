# Supabase project URL (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public publishable key used by the browser and server Supabase clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Base URL used to build staff invitation callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key used by the staff invitation API. Never expose this to the browser.
# Never add the NEXT_PUBLIC_ prefix and never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
